TQ_USER=your_kuaiqi_username
TQ_PASS=your_kuaiqi_password
# Market-data default can be main contract; trading scripts resolve to concrete FUTURE.
TQ_DEFAULT_SYMBOL=KQ.m@SHFE.rb

# Optional. Leave empty to keep the existing JSON/JSONL-only behavior.
# Use a dedicated, non-superuser role and keep the real password only in .env.
AK_DATABASE_URL=
AK_DATABASE_CONNECT_TIMEOUT=5
AK_DATABASE_STATEMENT_TIMEOUT_MS=5000

# Test-only: set AK_TEST_DATABASE_URL in the test process, not in this file.
# It must be a separate database whose name ends with _test.

# Market data MCP server (scripts/run_market_mcp.py)
# Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
AK_MCP_TOKEN=
AK_MCP_HOST=127.0.0.1
AK_MCP_PORT=17779
# Optional per-service statement budget (ms), clamped to 1000..60000
AK_MCP_STATEMENT_TIMEOUT_MS=15000
# Public-exposure hardening (scripts/run_market_mcp.py)
AK_MCP_RATE_PER_MINUTE=120
AK_MCP_ALLOWED_IPS=
