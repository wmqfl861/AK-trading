      "ticks": 4,
      "tick_field_set": "standard",
      "fixed_batch_id": "nf23-normalize-canonical"
    },
    "normalize_reject_violations_inprocess": {
      "shape": "reject_envelope",
      "flavors": ["invalid_tick", "ticks_limit", "invalid_quote"]
    },
    "normalize_max_legal_inprocess": {
      "shape": "envelope",
      "ticks": 1000,
      "tick_field_set": "minimal",
      "fixed_batch_id": "nf23-normalize-max"
    },
    "analyze_accept_typical_inprocess_hold_double": {
      "shape": "envelope",
      "ticks": 4,
      "tick_field_set": "standard",
