    "instrument_id": "rb2610",
    "symbol_count_per_payload": 1,
    "trading_day": "20260924",
    "market_status": "continuous",
    "contract_price_tick": 1,
    "contract_upper_limit": 4500,
    "contract_lower_limit": 3500
  },
  "clock": {
    "base_wall": "2026-09-24T01:30:00+00:00",
    "base_mono_s": 1000.0,
    "step_us_per_operation": 10000,
    "tick_offset_s": 0.5,
    "tick_stride_us": 50000
  },
  "cases": {
